#!/usr/bin/env bash
# Fully self-contained daily updater for Homepage fork.
set -euo pipefail

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/root/.local/share/pnpm:${PATH:-}"

REPO_DIR="${HOMEPAGE_DIR:-/opt/homepage}"
REMOTE_URL="https://github.com/audioscavenger/homepage.git"
BRANCH="lxc-maintenance"

mkdir -p "$REPO_DIR"
cd "$REPO_DIR"

git config --global --add safe.directory "$REPO_DIR" 2>/dev/null || true

if [[ ! -d .git ]]; then
  if [[ -z "$(ls -A 2>/dev/null)" ]]; then
    git clone --branch "$BRANCH" "$REMOTE_URL" .
  else
    git init
  fi
fi

if ! git remote get-url fork >/dev/null 2>&1; then
  git remote add fork "$REMOTE_URL"
else
  git remote set-url fork "$REMOTE_URL"
fi

git fetch fork "$BRANCH"

# Remove stale files from older Homepage releases that conflict with the fork.
rm -f middleware.js src/middleware.js src/src/middleware.js
rm -rf .next /opt/homepage-assets.backup
rm -rf node_modules/.cache
pnpm store prune >/dev/null 2>&1 || true

OLD_HEAD="$(git rev-parse HEAD 2>/dev/null || true)"
NEW_HEAD="$(git rev-parse "fork/$BRANCH")"

if [[ -n "$OLD_HEAD" && "$OLD_HEAD" == "$NEW_HEAD" ]]; then
  echo "No new commits on fork/$BRANCH; skipping build."
  exit 0
fi

git checkout -f -B "$BRANCH" "fork/$BRANCH"
git reset --hard "fork/$BRANCH"

pnpm install --frozen-lockfile
NEXT_TELEMETRY_DISABLED=1 pnpm build

restarted=0
for svc in homepage homepage.service next; do
  if systemctl list-unit-files "$svc" 2>/dev/null | grep -q "$svc"; then
    systemctl restart "$svc"
    restarted=1
    break
  fi
done

if [[ "$restarted" -eq 0 ]]; then
  echo "Build complete; no known systemd service found to restart." >&2
fi

echo "Homepage updated from fork/$BRANCH"
